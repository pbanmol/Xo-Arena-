rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isRegisteredUser() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Public read for registered user profiles & leaderboard
    match /users/{userId} {
      allow read: if true;
      allow write: if isRegisteredUser() && request.auth.uid == userId;
    }

    // Counters for sequential player UIDs (1, 2, 3...)
    match /counters/{counterId} {
      allow read, write: if isRegisteredUser();
    }

    // Matchmaking queue - registered players only
    match /matchmaking_queue/{userId} {
      allow read, write, delete: if isRegisteredUser() && request.auth.uid == userId;
    }

    // 6-digit Private Room codes - registered players only
    match /rooms/{roomCode} {
      allow read, write, delete: if isRegisteredUser();
    }

    // Online Matches (Turn sync, board state, rematches) - registered players only
    match /matches/{matchId} {
      allow read, write, delete: if isRegisteredUser();

      match /messages/{messageId} {
        allow read, write, delete: if isRegisteredUser();
      }
    }

    // Direct 1v1 challenges - registered players only
    match /challenges/{challengeId} {
      allow read, write, delete: if isRegisteredUser();
    }
  }
}
